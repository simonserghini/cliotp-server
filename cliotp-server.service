[Unit]
Description=cliotp-server (TOTP/HOTP/Steam API + web UI)
Documentation=https://github.com/yourname/cliotp-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cliotp
Group=cliotp
EnvironmentFile=/etc/cliotp-server.env
Environment=CLIOTP_DATA_DIR=/var/lib/cliotp-server
Environment=HOST=127.0.0.1
Environment=PORT=8080
ExecStart=/usr/bin/node /opt/cliotp-server/server.js
Restart=always
RestartSec=2

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cliotp-server
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
