# Copy to .env and fill in. docker compose reads this automatically.
# Generate a strong token:  openssl rand -hex 32
CLIOTP_TOKEN=
CLIOTP_DATA_DIR=/data
PORT=8080
HOST=0.0.0.0

# Optional TLS (recommended: put the server behind a reverse proxy instead):
#CLIOTP_TLS_CERT=/certs/fullchain.pem
#CLIOTP_TLS_KEY=/certs/privkey.pem

# Google sign-in for the web UI (optional — API-key login works without these).
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# with the redirect URI https://YOUR_HOST/auth/google/callback
#GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=xxxx
#GOOGLE_ALLOWED_EMAILS=you@gmail.com
#SESSION_SECRET=<openssl rand -hex 32>
#GOOGLE_REDIRECT_URI=https://YOUR_HOST/auth/google/callback

# Optional hardening:
#CLIOTP_ALLOW_IP=10.0.0.0/8,192.168.1.0/24   # comma-separated IPs/CIDRs (all if unset)
#CLIOTP_RATE_LIMIT=300                        # max requests/min per IP on /api
#CLIOTP_AUTH_MAX_FAILS=10                     # failed auths before 429
#CLIOTP_AUTH_WINDOW_MS=900000                 # failed-auth window (15 min)
#CLIOTP_TRUST_PROXY=1                         # honor X-Forwarded-For (only behind a proxy)
#CLIOTP_LOG=0                                 # disable the /api access log
